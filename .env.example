# Скопируйте в .env и заполните.

# Vapi → Dashboard → API Keys → Private key. Секретный, только в .env.
VAPI_API_KEY=

# Vapi → Phone Numbers → id номера, с которого звоним (импортированный из Twilio или SIP).
# Для разговора в браузере не нужен.
VAPI_PHONE_NUMBER_ID=

# Vapi → Dashboard → API Keys → Public key. Нужен только демо-странице (`python -m voicebot site`):
# он виден в коде страницы, поэтому в Vapi ограничьте его своим сайтом (Allowed Origins).
VAPI_PUBLIC_KEY=
